{
  "openapi": "3.1.0",
  "info": {
    "title": "INTEC Schedule API",
    "version": "1.0.0"
  },
  "paths": {
    "/schedule": {
      "post": {
        "tags": [
          "schedule"
        ],
        "summary": "Get Schedule",
        "operationId": "get_schedule_schedule_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/user/login": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Login",
        "operationId": "login_user_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/user/refresh-token": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Refresh Token",
        "operationId": "refresh_token_user_refresh_token_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Get Health",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Get Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcademicClass": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "subjectCode": {
            "type": "string",
            "title": "Subjectcode"
          },
          "subjectName": {
            "type": "string",
            "title": "Subjectname"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "professor": {
            "type": "string",
            "title": "Professor"
          },
          "day": {
            "type": "integer",
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Day",
            "description": "ISO weekday: Monday=1"
          },
          "startTime": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "title": "Starttime"
          },
          "endTime": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "title": "Endtime"
          },
          "location": {
            "type": "string",
            "title": "Location"
          }
        },
        "type": "object",
        "required": [
          "id",
          "subjectCode",
          "subjectName",
          "section",
          "professor",
          "day",
          "startTime",
          "endTime",
          "location"
        ],
        "title": "AcademicClass"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "studentId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Studentid"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "studentId",
          "password"
        ],
        "title": "LoginRequest"
      },
      "RefreshTokenRequest": {
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "format": "password",
            "title": "Refreshtoken",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "title": "RefreshTokenRequest"
      },
      "ScheduleResponse": {
        "properties": {
          "student": {
            "$ref": "#/components/schemas/Student"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Fetchedat"
          },
          "classes": {
            "items": {
              "$ref": "#/components/schemas/AcademicClass"
            },
            "type": "array",
            "title": "Classes"
          },
          "unscheduledSubjects": {
            "items": {
              "$ref": "#/components/schemas/UnscheduledSubject"
            },
            "type": "array",
            "title": "Unscheduledsubjects"
          }
        },
        "type": "object",
        "required": [
          "student",
          "fetchedAt",
          "classes"
        ],
        "title": "ScheduleResponse"
      },
      "Student": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "isPino": {
            "type": "boolean",
            "title": "Ispino"
          }
        },
        "type": "object",
        "required": [
          "id",
          "isPino"
        ],
        "title": "Student"
      },
      "TokenResponse": {
        "properties": {
          "accessToken": {
            "type": "string",
            "title": "Accesstoken"
          },
          "refreshToken": {
            "type": "string",
            "title": "Refreshtoken"
          },
          "tokenType": {
            "type": "string",
            "title": "Tokentype"
          },
          "expiresIn": {
            "type": "integer",
            "title": "Expiresin"
          }
        },
        "type": "object",
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn"
        ],
        "title": "TokenResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "UnscheduledSubject": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "not_reported",
              "to_be_announced",
              "asynchronous"
            ],
            "title": "Reason",
            "default": "not_reported"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "subjectCode": {
            "type": "string",
            "minLength": 1,
            "title": "Subjectcode"
          },
          "subjectName": {
            "type": "string",
            "minLength": 1,
            "title": "Subjectname"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "professor": {
            "type": "string",
            "title": "Professor",
            "default": ""
          },
          "location": {
            "type": "string",
            "title": "Location",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "subjectCode",
          "subjectName",
          "section"
        ],
        "title": "UnscheduledSubject"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://03lghnqjli.execute-api.us-east-1.amazonaws.com/dev",
      "description": "Desarrollo; contrato verificado el 2026-09-18"
    }
  ]
}
