# Configuración pública incorporada al build. Nunca incluir secretos.
# mock: demostración; http: backend bajo el mismo origen /api/academic/schedule.
VITE_ACADEMIC_API_MODE=mock

# Solo desarrollo: origen real del backend, sin /api al final.
# Ejemplo: API_PROXY_TARGET=http://localhost:8000
# No usa prefijo VITE_: este valor no se incorpora al navegador.
API_PROXY_TARGET=
