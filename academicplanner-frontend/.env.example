# Configuración pública incorporada al build. Nunca incluir secretos.
# mock: demostración; http: login y horario mediante el proxy /api.
VITE_ACADEMIC_API_MODE=mock

# Solo desarrollo. URL base; admite el prefijo de etapa /dev.
# Para conectar el backend compartido, activar http arriba y descomentar:
# API_PROXY_TARGET=https://03lghnqjli.execute-api.us-east-1.amazonaws.com/dev
# No usa prefijo VITE_: este valor no se incorpora al navegador.
API_PROXY_TARGET=
